<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MCModpackAutoUpdater</AssemblyName>
    <RootNamespace>MCModpackAutoUpdater</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-MCModpackAutoUpdater-237d75f7-6d5e-454e-8c51-e24c58cf8b15</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCAgent\MCAgent.csproj" />
    <InternalsVisibleTo Include="MCModpackAutoUpdater.Tests" />
    <Content Update="appsettings.Local.json;appsettings.*.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="RemoveMCAgentStandaloneFilesFromWebPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Replace('/', '\').Contains('\MCAgent\appsettings.'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Replace('/', '\').Contains('\MCAgent\scripts\'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.RelativePath)' == 'MCAgent' Or
                                        '%(ResolvedFileToPublish.RelativePath)' == 'MCAgent.exe' Or
                                        '%(ResolvedFileToPublish.RelativePath)' == 'MCAgent.deps.json' Or
                                        '%(ResolvedFileToPublish.RelativePath)' == 'MCAgent.runtimeconfig.json'" />
    </ItemGroup>
  </Target>

</Project>
